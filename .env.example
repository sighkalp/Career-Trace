# CareerTrace Environment Variables
# ---------------------------------

# [Required for AI Guide] Get a key from https://integrate.api.nvidia.com
NVIDIA_API_KEY="your-nvidia-api-key"

# [Optional] The NVIDIA model to use (defaults to meta/llama-3.1-8b-instruct)
# Fast options: meta/llama-3.1-8b-instruct (recommended), mistralai/mistral-7b-instruct-v0.3
# Best quality: meta/llama-3.3-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_MODEL="meta/llama-3.1-8b-instruct"

# [Required for Production/Data Isolation]
# The connection string to your MongoDB Atlas cluster.
# In local development, if left blank, it defaults to mongodb://127.0.0.1:27017
# Example: MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=CareerTrace"
MONGODB_URI=""

# [Required for Auth] Secret key used to sign JWT session tokens
# Change this to a random long string in production
JWT_SECRET="careertrace_secret_mvp"

# [Optional] Port and Host for the server
PORT=3000
HOST="0.0.0.0"
